<!--
  Developer-tier APIM variant: validate-content/content-type-map is not
  supported on wfprod-apim-dev; IP rate limit only for bearer-exempt pairing.
-->
<policies>
  <inbound>
    <set-header name="X-WriterFlow-Origin" exists-action="override">
      <value>{{writerflow-origin-secret}}</value>
    </set-header>
    <!-- Device token polls every ~5s for up to several minutes while the
         user signs in in the browser. 10/min rejects a normal approve wait;
         60/min covers authorize + poll + deep-link hint without opening
         user_code guessing. Backend slow_down still enforces per-code cadence. -->
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override">
      <value>no-store</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
