<!--
  Operation-level override for POST /v2/inference/stream — the one SSE
  endpoint. Stage 5.4: "Configure APIM forward-request buffer-response=false,
  no response cache, and no request/response body logging for SSE."
  Status: code complete; cloud apply pending.
-->
<policies>
  <inbound>
    <base />
    <!-- Preserve the client-generated Idempotency-Key exactly. The backend
         requires and validates it; APIM must never synthesize a different
         operation identity on a retry. -->
  </inbound>
  <backend>
    <forward-request buffer-request-body="true" buffer-response="false" timeout="120" />
  </backend>
  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override">
      <value>no-store</value>
    </set-header>
    <set-header name="X-Accel-Buffering" exists-action="override">
      <value>no</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
