# Local dev only. Copy to .env.services (gitignored) and adjust as needed.
# Staging/prod source these from Key Vault via infra/bicep, never from a file.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# services/api/migrations/001_roles.cjs creates writerflow_app with this
# password when WRITERFLOW_APP_ROLE_PASSWORD is unset — fine for a throwaway
# local Docker Postgres, never for staging/prod.
WRITERFLOW_APP_ROLE_PASSWORD=writerflow_app_dev_only

# Matches docker-compose.yml's postgres service. Migrations run as the
# migrator/owner role (superuser in local dev).
DATABASE_URL=postgres://writerflow_migrator:writerflow_migrator_dev_only@localhost:5432/writerflow

# services/api's runtime pool should connect as writerflow_app once
# migration 001 has created that role, not as the migrator — set this for
# `npm run dev`/`npm start`, separately from the migration DATABASE_URL above.
# DATABASE_URL=postgres://writerflow_app:writerflow_app_dev_only@localhost:5432/writerflow
