# Keep "candidate" until every manual release gate in ../RELEASE.md passes and
# both v1.0.0 assets exist at the immutable release URLs below.
NEXT_PUBLIC_RELEASE_STATUS=candidate

# Optional. Defaults to the immutable GitHub Release v1.0.0 asset directory.
# For a same-origin static host, use a path such as /downloads/v1.0.0.
# NEXT_PUBLIC_RELEASE_ASSET_BASE_URL=https://github.com/karnmodi/WriterFlow/releases/download/v1.0.0

# Required only by verify-release-live when the asset base is root-relative.
# NEXT_PUBLIC_SITE_ORIGIN=https://writerflow.example
