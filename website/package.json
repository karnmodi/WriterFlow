{
  "name": "writerflow-launch-site",
  "version": "1.0.0",
  "private": true,
  "description": "WriterFlow public site — static marketing pages plus the v2 confidential Entra client and /pair device-approval route.",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.14.x",
    "npm": "11.11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate-build": "node scripts/validate-build.mjs",
    "verify-release-local": "node scripts/verify-release-assets.mjs --local",
    "verify-release-live": "node scripts/verify-release-assets.mjs --remote",
    "check": "npm run lint && npm run typecheck && npm run build && npm run validate-build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.19",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
