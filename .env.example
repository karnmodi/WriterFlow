# LOCAL DEVELOPMENT ONLY — copy to `.env` and fill in your own Azure values.
# Never commit, package, publish, or distribute `.env` or these credentials.
#
# Public users do NOT use this file. They paste endpoint + API key + deployment
# names in Setup / Dashboard → Settings (bring-your-own-key). See RELEASE.md.

# Full Responses API URL, including api-version query param.
# Example:
# TARGET_URI=https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
TARGET_URI=

# Your Azure OpenAI API key (local bootstrap into Keychain only).
API_KEY_GPT_5-4_Pro=

# Deployment names in your Azure OpenAI resource (must match exactly).
AZURE_OPENAI_DEPLOYMENT_GPT_5-4_Mini=
AZURE_OPENAI_DEPLOYMENT_GPT_5-4_Pro=

# Optional / unused by the app today — kept for local scripts / future slots.
# AZURE_OPENAI_DEPLOYMENT_GPT_5-2_Chat=
# AZURE_OPENAI_DEPLOYMENT_GPT_5-3_Codex=
# AZURE_OPENAI_DEPLOYMENT_GPT_5-4=
# AZURE_OPENAI_DEPLOYMENT_GPT_IMAGE_2=
# AZURE_OPENAI_DEPLOYMENT_O3_Pro=
# AZURE_OPENAI_API_VERSION=
